# Copy this file to .env and fill in the API keys. Do not commit .env.

# API credentials and service connection settings (keep these at the top).
GROQ_API_KEY=
SUPERMEMORY_API_KEY=
GOOGLE_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
SHOPSENSE_CASE_ID_SALT=
SHOPSENSE_M7_TRACE_PII_SALT=

# Milestone-specific LLM and embedding models (M1 → M8).
# M1: support-ticket parsing LLM.
SHOPSENSE_M1_MODEL="groq/qwen/qwen3.8-27b"
# M2: customer-care agent LLM.
SHOPSENSE_M2_MODEL="groq/qwen/qwen3.8-27b"
# M3: rolling conversation-summary LLM, then policy-index embedding model.
SHOPSENSE_M3_SUMMARY_MODEL="gemini/gemini-3.5-flash-lite"
SHOPSENSE_M3_POLICY_EMBEDDING_MODEL="gemini-embedding-001"
# M4: policy-answer LLM, then policy-query embedding model.
SHOPSENSE_M4_MODEL="groq/qwen/qwen3.8-27b"
SHOPSENSE_M4_POLICY_EMBEDDING_MODEL="gemini-embedding-001"
# M5: workflow policy-retrieval embedding model; no chat LLM call in M5.
SHOPSENSE_M5_POLICY_EMBEDDING_MODEL="gemini-embedding-001"
# M6: shared model for the Supervisor and model-backed specialist agents.
SHOPSENSE_M6_MODEL="groq/qwen/qwen3.8-27b"
# M6: rolling conversation-summary model, used separately from long-term memory.
SHOPSENSE_M6_SUMMARY_MODEL="gemini/gemini-3.5-flash-lite"
# M6: must match the M3 embedding model because it queries the same Qdrant collection.
SHOPSENSE_M6_POLICY_EMBEDDING_MODEL="gemini-embedding-001"
# M7: M6 live-case model and rolling summary model, separated for tracing/reliability runs.
SHOPSENSE_M7_MODEL="groq/qwen/qwen3.8-27b"
SHOPSENSE_M7_SUMMARY_MODEL="gemini/gemini-3.5-flash-lite"
# M7: must match the M3 embedding model because it queries the same Qdrant collection.
SHOPSENSE_M7_POLICY_EMBEDDING_MODEL="gemini-embedding-001"
# M8: FastAPI live-case model, independent golden-evaluation judge, and rolling summary model.
SHOPSENSE_M8_MODEL="groq/qwen/qwen3.8-27b"
SHOPSENSE_M8_EVALUATION_MODEL="groq/qwen/qwen3.8-27b"
SHOPSENSE_M8_SUMMARY_MODEL="gemini/gemini-3.5-flash-lite"
# M8: must match the M3 embedding model because it queries the same Qdrant collection.
SHOPSENSE_M8_POLICY_EMBEDDING_MODEL="gemini-embedding-001"

# Supporting settings (not LLM or embedding models).
SHOPSENSE_M3_POLICY_COLLECTION="shopsense_policy_documents"
# Auxiliary local rerankers; these download once on first use and are cached.
# M4 hybrid RAG reranker.
SHOPSENSE_M4_RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
# M5 workflow policy-retrieval reranker.
SHOPSENSE_M5_RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
# M6 policy-RAG reranker.
SHOPSENSE_M6_RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
# M7 policy-RAG reranker.
SHOPSENSE_M7_RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
# M8 policy-RAG reranker.
SHOPSENSE_M8_RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
